# ============================================================
# Horizon deployment environment variables
# Copy this file to horizon.env and fill in your values.
# horizon.env is gitignored and will never be committed.
# ============================================================

# Evertrust repository credentials
export EVERTRUST_REPO_USERNAME='your_repo_username'
export EVERTRUST_REPO_PASSWORD='your_repo_password'

# Licence
export HORIZON_LICENCE_PATH=/path/to/your/horizon.lic

# MongoDB credentials (user must be pre-created in MongoDB)
export HORIZON_MONGODB_USERNAME='horizon_db_admin'
export HORIZON_MONGODB_PASSWORD='your_mongodb_password'

# Secret keys (leave empty to auto-generate on first run)
# Once generated, save the values and set them here for idempotent re-runs
export HORIZON_PLAY_HTTP_SECRET_KEY=''
export HORIZON_DEFAULT_SSV_KEY=''
export HORIZON_EVENT_SEAL_SECRET=''

# ------------------------------------------------------------
# Tinkey - Soft mode (default, no KMS)
# Leave the vars below empty or commented out for soft mode.
# ------------------------------------------------------------
#export HORIZON_TINK_MASTER_KEY_URI=
#export HORIZON_TINK_CREDENTIALS_PATH=
#export HORIZON_TINK_CREDENTIALS_SRC_PATH=

# ------------------------------------------------------------
# Tinkey - GCP KMS (uncomment to use)
# ------------------------------------------------------------
#export HORIZON_TINK_MASTER_KEY_URI='gcp-kms://projects/YOUR_PROJECT/locations/YOUR_REGION/keyRings/YOUR_KEYRING/cryptoKeys/YOUR_KEY'
#export HORIZON_TINK_CREDENTIALS_PATH=/opt/horizon/etc/tink-credentials.json
#export HORIZON_TINK_CREDENTIALS_SRC_PATH=/path/to/your/gcp-credentials.json

# ------------------------------------------------------------
# Tinkey - AWS KMS (uncomment to use)
# ------------------------------------------------------------
#export HORIZON_TINK_MASTER_KEY_URI='aws-kms://arn:aws:kms:YOUR_REGION:YOUR_ACCOUNT_ID:key/YOUR_KEY_ID'
#export HORIZON_TINK_CREDENTIALS_PATH=/opt/horizon/etc/aws-credentials
#export HORIZON_TINK_CREDENTIALS_SRC_PATH=/path/to/your/aws-credentials