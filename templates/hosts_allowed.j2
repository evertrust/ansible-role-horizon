{% set start_index = 4 %}
{% for node in horizon_nodes %}
play.filters.hosts.allowed.{{ start_index + loop.index0 }}="{{ node.hostname }}"
{% endfor %}
{% if horizon_extra_allowed_hosts | default([]) | length > 0 %}
{% for host in horizon_extra_allowed_hosts %}
play.filters.hosts.allowed.{{ start_index + horizon_nodes | length + loop.index0 }}="{{ host }}"
{% endfor %}
{% endif %}

# Akka cluster split-brain resolver configuration
{% if horizon_nodes | length > 1 %}
akka.cluster.split-brain-resolver {
    active-strategy = "lease-majority"
    lease-majority {
      lease-implementation = "lease.mongo"
    }
}
{% endif %}